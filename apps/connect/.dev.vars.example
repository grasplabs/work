# Copy to .dev.vars for local development. Never commit real values.
# Verifies the capability core signs for each call. The same value as in
# apps/core/.dev.vars; at least 32 characters, e.g. `openssl rand -base64 32`.
CAPABILITY_SIGNING_KEY=
# Optional: Stephen's own Gmail mailbox (src/channels.ts), and the Google
# OAuth client and refresh token connect reads and sends its mail with.
# Every Gmail request is refused until all four are set.
GMAIL_MAILBOX=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional: Grasp's own keys at the AI providers, for platform features
# (src/ai-providers.ts). A provider whose key is unset isn't offered for
# them; an organization's own keys are added in the product, not here.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
