// Deployed only to grasp-os-ops, by hand with deploy-ops (never to staging, where
// it would have no route), behind Cloudflare Access (company sign-in + MFA).
// The Worker verifies the Access JWT on every request itself (src/access.ts),
// against the CF_ACCESS_AUD and CF_ACCESS_ISS vars; without them it refuses
// everything. Deploy-ops passes them from the grasp-os-ops environment's
// variables with `--var`, and stops if either is missing.
// The token it reaches client accounts with lives in Secrets Store, never in
// the database.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "grasp-os-console",
  // TanStack Start's handler, behind the Access check.
  "main": "src/server.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // The Access vars come from each deploy's `--var`, not from here
  // (src/env.d.ts); this keeps them too on a deploy that passes none, such
  // as `wrangler deploy` by hand.
  "keep_vars": true,
  // No platform line per invocation, and query strings stay out of logs and
  // traces, as on every Worker (threat model R17).
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": true },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grasp-os-console",
      "migrations_dir": "src/db/migrations",
    },
  ],
  // The releases CI publishes (scripts/release/upload-release.ts), in the
  // EU. The console only reads them: src/releases/import.ts takes the
  // binding as a store with nothing but `get` and `list`.
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "grasp-os-releases",
      "jurisdiction": "eu",
    },
  ],
  // Imports newly published releases (src/releases/import.ts) every 5
  // minutes; on weekday mornings, posts the admin's digest to Discord
  // (src/admin/discord-digest.ts, `digestCron`).
  "triggers": { "crons": ["*/5 * * * *", "0 6,7 * * 1-5"] },
  // Onboards a client (src/provision/workflow.ts): an instance per attempt,
  // each claimed in D1 first (src/runners.ts), so two runs for one
  // client can't overlap.
  "workflows": [
    {
      "name": "grasp-os-provision-client",
      "binding": "PROVISION_CLIENT",
      "class_name": "ProvisionClient",
    },
    // Rolls a release out to clients, ring by ring (src/rollout/workflow.ts):
    // an instance per rollout, which claims each client in D1 while it
    // deploys it (src/runners.ts), so it never runs beside the
    // client's provisioning or another rollout.
    {
      "name": "grasp-os-rollout",
      "binding": "ROLLOUT",
      "class_name": "Rollout",
    },
    // Deploys one fleet client of a rollout (src/rollout/fleet-client.ts): an
    // instance per client and retry round, a few at once, started by the
    // rollout's run, which claims the client in the rollout's name.
    {
      "name": "grasp-os-rollout-client",
      "binding": "ROLLOUT_CLIENT",
      "class_name": "RolloutClient",
    },
    // Rolls a client back from a rollout (src/rollout/rollback.ts): an
    // instance per rollback, a runner under the same claim as the others.
    {
      "name": "grasp-os-rollback-client",
      "binding": "ROLLBACK_CLIENT",
      "class_name": "RollbackClient",
    },
    // Applies a client's settings now (src/clients/apply.ts): a deploy of
    // the release it runs, all at once, under the same claim as the others.
    {
      "name": "grasp-os-apply-client",
      "binding": "APPLY_CLIENT",
      "class_name": "ApplyClient",
    },
    // Provisions a client placed in a hosting destination
    // (src/hosting/workflow.ts): an instance per attempt, each claimed in
    // D1 first, all resuming the client's one operation.
    {
      "name": "grasp-os-provision-placed-client",
      "binding": "PROVISION_PLACED_CLIENT",
      "class_name": "ProvisionPlacedClient",
    },
  ],
  // The router's hostname map, which a deploy writes (src/deploy/router.ts).
  // The router's first deploy creates it as grasp-os-router-hosts; `deploy`
  // fills in its id (scripts/wrangler-deploy.ts), so this placeholder only
  // reaches local runs and tests.
  "kv_namespaces": [
    { "binding": "ROUTER_HOSTS", "id": "router-hosts-namespace" },
  ],
  // What provisioning and deploys need from the account's Secrets Store
  // (src/deploy/context.ts): the tenant admin's token, which only creates
  // accounts and makes the deployer a member (src/provision/workflow.ts);
  // the deployer's token, with deploy permissions only, on every client
  // account (AI Gateway edit among them: provisioning makes each client's
  // gateway; and Zone and Email Sending edit: a deploy makes the client's
  // sending domain, src/cloudflare/email-sending.ts); the keys each client's own secrets are derived from; and the
  // secrets every client shares, which deploy-ops copies in from
  // 1Password. The store id is the account's own: `deploy` fills it in
  // (scripts/wrangler-deploy.ts), so this placeholder only reaches local
  // runs and tests.
  "secrets_store_secrets": [
    {
      "binding": "TENANT_ADMIN_TOKEN",
      "store_id": "account-secrets-store",
      "secret_name": "TENANT_ADMIN_TOKEN",
    },
    {
      "binding": "DEPLOYER_API_TOKEN",
      "store_id": "account-secrets-store",
      "secret_name": "DEPLOYER_API_TOKEN",
    },
    {
      "binding": "ROUTER_KEY",
      "store_id": "account-secrets-store",
      "secret_name": "ROUTER_KEY",
    },
    {
      "binding": "CLIENT_KEY",
      "store_id": "account-secrets-store",
      "secret_name": "CLIENT_KEY",
    },
    {
      "binding": "ENTRA_CLIENT_SECRET",
      "store_id": "account-secrets-store",
      "secret_name": "ENTRA_CLIENT_SECRET",
    },
    {
      "binding": "MICROSOFT_CLIENT_SECRET",
      "store_id": "account-secrets-store",
      "secret_name": "MICROSOFT_CLIENT_SECRET",
    },
    {
      "binding": "GOOGLE_CLIENT_SECRET",
      "store_id": "account-secrets-store",
      "secret_name": "GOOGLE_CLIENT_SECRET",
    },
    {
      "binding": "COMPOSIO_API_KEY",
      "store_id": "account-secrets-store",
      "secret_name": "COMPOSIO_API_KEY",
    },
    {
      "binding": "APP_OAUTH_CLIENTS",
      "store_id": "account-secrets-store",
      "secret_name": "APP_OAUTH_CLIENTS",
    },
    // A restricted Stripe key that can only read customers, subscriptions
    // and invoices, for the admin's Billing under Contract
    // (src/billing/stripe.ts). The console's alone: never copied to a
    // client, never sent to the browser. Put in the store by hand; until
    // it is, Billing says Stripe isn't connected.
    {
      "binding": "STRIPE_RESTRICTED_KEY",
      "store_id": "account-secrets-store",
      "secret_name": "STRIPE_RESTRICTED_KEY",
    },
    // Grasp's Rooms' read-only service token (grasplabs/rooms,
    // worker/service-read.ts), for the proposal under Contract
    // (src/proposal/rooms.ts): it reads rooms and their signature requests
    // and nothing else. The console's alone, never sent to the browser. Put
    // in the store by hand; until it is, the proposal says Rooms isn't
    // connected.
    {
      "binding": "ROOMS_READ_TOKEN",
      "store_id": "account-secrets-store",
      "secret_name": "ROOMS_READ_TOKEN",
    },
    // The Discord webhook the admin's morning digest is posted to, which
    // names the channel (src/admin/discord-digest.ts). The console's alone.
    // Put in the store by hand; until it is, no digest is sent.
    {
      "binding": "DISCORD_DIGEST_WEBHOOK",
      "store_id": "account-secrets-store",
      "secret_name": "DISCORD_DIGEST_WEBHOOK",
    },
    // A read-only Attio API key (records, object configuration, notes and
    // meetings read; user management read to name deal owners), for the
    // company, its people, deals and calls under Details and the won deals
    // a new organization starts from (src/crm/attio.ts). The console's
    // alone: never copied to a client, never sent to the browser. Put in
    // the store by hand; until it is, Details says Attio isn't connected.
    {
      "binding": "ATTIO_READ_KEY",
      "store_id": "account-secrets-store",
      "secret_name": "ATTIO_READ_KEY",
    },
  ],
}
