// Deployed only by hand, with deploy-platform (never by CI on a merge), behind
// Cloudflare Access (company sign-in + MFA).
// The Worker verifies the Access JWT on every request itself (src/access.ts),
// against the CF_ACCESS_AUD and CF_ACCESS_ISS vars; without them it refuses
// everything, so a deploy of a stage missing either stops (cf-worker.ts).
// The token it reaches client accounts with lives in Secrets Store, never in
// the database.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "grasp-admin",
  // TanStack Start's handler, behind the Access check.
  "main": "src/server.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // The admin's own hostname, as a route: more specific than the router's
  // for every host below the stage's client domain, so it wins over it,
  // where a Custom Domain wouldn't, as routes run first
  // (@grasp-os/shared/names, `platformRoutes`, which check:wrangler-configs
  // holds this to). Deployed by cf as a fetch trigger (cf-worker.ts).
  "routes": [{ "pattern": "admin.ongrasp.app/*", "zone_name": "ongrasp.app" }],
  // Every setting of the admin's, none of them secret (src/env.d.ts says
  // what each does): production here, staging in `env.staging`, which
  // repeats every binding under its staging name, as wrangler inherits none
  // of them. STAGE is the stage this Worker serves (@grasp-os/shared/names);
  // CF_ACCESS_ISS is Grasp Work's Access team, and CF_ACCESS_AUD its
  // application's tag; ENTRA_CLIENT_ID and GOOGLE_CLIENT_ID are Grasp's
  // Entra and Google OAuth apps, which each client's core and connect sign
  // in with; CLIENT_DOMAIN is where
  // clients are served, and ADMIN_HOST the admin's own hostname, both as the
  // names module gives them (check:wrangler-configs holds them to it);
  // OAUTH_RELAY "on" sends every client's sign-in and connections back
  // through the stage's OAuth relay, as every client this admin deploys is
  // Grasp-hosted (src/deploy/context.ts, `oauthRelayOf`), and "off" to
  // each client's own origin. ROOMS_ORIGIN is Grasp's Rooms' team origin
  // (e.g. https://rooms.grasp.example), which the proposal under Contract
  // is read from (src/proposal/rooms.ts); DISCORD_PUBLIC_KEY is Grasp's
  // Discord application's public key, hex (General Information), which
  // every interaction Discord posts to the bot is signed with, and
  // DISCORD_STAFF_IDS the Discord user ids of Grasp's staff, comma-separated:
  // the only people the bot answers (src/admin/discord.ts). An empty one is
  // a setting not configured yet; the admin works without it (Rooms isn't
  // read, the bot refuses everything), except the Access pair, without
  // which nothing is deployed. Which organization is Grasp's own is chosen
  // on Platform (the admin's database), and secrets live in the stage's
  // 1Password Environment.
  "vars": {
    "STAGE": "production",
    "CF_ACCESS_AUD": "add0b0ab1499430cad8a9bd2fa5f83da725684c0df9487cf057880c7bc4e2a8d",
    "CF_ACCESS_ISS": "https://grasp-work.cloudflareaccess.com",
    "ENTRA_CLIENT_ID": "01228906-bd5b-488e-b7c1-720f4dc12dc2",
    "GOOGLE_CLIENT_ID": "740037143590-b2d0cpupcj0t800rth3ekr6g310unatv.apps.googleusercontent.com",
    "CLIENT_DOMAIN": "ongrasp.app",
    "ADMIN_HOST": "admin.ongrasp.app",
    "OAUTH_RELAY": "on",
    "ROOMS_ORIGIN": "",
    "DISCORD_PUBLIC_KEY": "",
    "DISCORD_STAFF_IDS": "",
  },
  // No platform line per invocation, and query strings stay out of logs and
  // traces, as on every Worker (threat model R17).
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": true },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grasp-admin",
      "migrations_dir": "src/db/migrations",
    },
  ],
  // The releases CI publishes (scripts/release/upload-release.ts), in the
  // EU. The admin only reads them: src/releases/import.ts takes the
  // binding as a store with nothing but `get` and `list`.
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "grasp-releases",
      "jurisdiction": "eu",
    },
  ],
  // Per-person limits on reads that reach every client's core once. The
  // namespace ids are unique in Grasp's account, beside the router's 1001
  // to 1003.
  "ratelimits": [
    // Tool calls of the admin's MCP (src/admin/mcp.ts), per staff member:
    // 30 a minute.
    {
      "name": "ADMIN_MCP_RATE_LIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 30, "period": 60 },
    },
    // Questions to Grasp's Discord bot (src/admin/discord.ts), per Discord
    // user: 10 a minute.
    {
      "name": "DISCORD_RATE_LIMIT",
      "namespace_id": "1005",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // The Chat SDK's state for Grasp's Discord bot (src/admin/discord.ts,
  // @grasp-os/chat/state): one SQLite object per key and per conversation,
  // in the EU. And the admin's workflow runs on Workerflow
  // (src/workflow-runs.ts): one SQLite object per run, in the EU.
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_STATE", "class_name": "ChatState" },
      { "name": "ADMIN_RUNS", "class_name": "AdminRuns" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatState"] },
    { "tag": "v2", "new_sqlite_classes": ["AdminRuns"] },
  ],
  // Imports newly published releases (src/releases/import.ts) every 5
  // minutes; on weekday mornings, posts the admin's digest to Discord
  // (src/admin/discord-digest.ts, `digestCron`); every hour, watches
  // Stephen at every client (src/clients/watch.ts, `watchCron`).
  "triggers": {
    "crons": ["*/5 * * * *", "0 6,7 * * 1-5", "45 * * * *"],
  },
  // The router's hostname map, which a deploy writes (src/deploy/router.ts).
  // scripts/cloudflare-account-setup.ts creates it as grasp-router-hosts
  // (-staging in staging, @grasp-os/shared/names); `deploy`
  // fills in its id (scripts/wrangler-deploy.ts), so this placeholder only
  // reaches local runs and tests.
  "kv_namespaces": [
    { "binding": "ROUTER_HOSTS", "id": "router-hosts-namespace" },
  ],
  // The clients' Workers for Platforms namespace, as the router binds it
  // (@grasp-os/shared/names, `clientsNamespace`): how the admin
  // reaches a client's core there, to check it before its hostname goes in
  // the map and to ask it what staff read (src/clients/core-address.ts).
  "dispatch_namespaces": [
    { "binding": "DISPATCHER", "namespace": "grasp-clients" },
  ],
  // What provisioning and releases need from the account's Secrets Store
  // (src/deploy/context.ts): the deployer's token, with deploy permissions
  // only, on every hosting destination's account (Zone and Email Sending
  // edit among them: provisioning makes the client's sending domain,
  // src/cloudflare/email-sending.ts); the keys each client's own secrets
  // are derived from; and the secrets every client shares. Deploy platform
  // copies every one of them in from the stage's 1Password Environment
  // (scripts/store-secrets.ts). The store id is the account's own: `deploy` fills it in
  // (scripts/wrangler-deploy.ts), so this placeholder only reaches local
  // runs and tests.
  "secrets_store_secrets": [
    {
      "binding": "DEPLOYER_API_TOKEN",
      "store_id": "account-secrets-store",
      "secret_name": "DEPLOYER_API_TOKEN",
    },
    {
      "binding": "ROUTER_KEY",
      "store_id": "account-secrets-store",
      "secret_name": "ROUTER_KEY",
    },
    {
      "binding": "CLIENT_KEY",
      "store_id": "account-secrets-store",
      "secret_name": "CLIENT_KEY",
    },
    {
      "binding": "ENTRA_CLIENT_SECRET",
      "store_id": "account-secrets-store",
      "secret_name": "ENTRA_CLIENT_SECRET",
    },
    {
      "binding": "MICROSOFT_CLIENT_SECRET",
      "store_id": "account-secrets-store",
      "secret_name": "MICROSOFT_CLIENT_SECRET",
    },
    {
      "binding": "GOOGLE_CLIENT_SECRET",
      "store_id": "account-secrets-store",
      "secret_name": "GOOGLE_CLIENT_SECRET",
    },
    {
      "binding": "COMPOSIO_API_KEY",
      "store_id": "account-secrets-store",
      "secret_name": "COMPOSIO_API_KEY",
    },
    {
      "binding": "APP_OAUTH_CLIENTS",
      "store_id": "account-secrets-store",
      "secret_name": "APP_OAUTH_CLIENTS",
    },
    // Grasp's own AI provider keys, which pay for its platform features
    // (converting PDFs for the Brain, transcription, speech, fixed in
    // core's src/platform-ai.ts). Every client's connect gets them as
    // shared secrets, never its core (src/deploy/context.ts). Optional:
    // added to the stage's 1Password Environment, each is bound at the next
    // Deploy platform; until then, the features on its provider aren't
    // available in any organization.
    {
      "binding": "OPENAI_API_KEY",
      "store_id": "account-secrets-store",
      "secret_name": "OPENAI_API_KEY",
    },
    {
      "binding": "ANTHROPIC_API_KEY",
      "store_id": "account-secrets-store",
      "secret_name": "ANTHROPIC_API_KEY",
    },
    {
      "binding": "MISTRAL_API_KEY",
      "store_id": "account-secrets-store",
      "secret_name": "MISTRAL_API_KEY",
    },
    {
      "binding": "OPENROUTER_API_KEY",
      "store_id": "account-secrets-store",
      "secret_name": "OPENROUTER_API_KEY",
    },
    {
      "binding": "ELEVENLABS_API_KEY",
      "store_id": "account-secrets-store",
      "secret_name": "ELEVENLABS_API_KEY",
    },
    // A restricted Stripe key that can only read customers, subscriptions
    // and invoices, for the admin's Billing under Contract
    // (src/billing/stripe.ts). The admin's alone: never copied to a
    // client, never sent to the browser. Optional: added to the stage's
    // 1Password Environment, it's bound at the next Deploy platform; until
    // then, Billing says Stripe isn't connected.
    {
      "binding": "STRIPE_RESTRICTED_KEY",
      "store_id": "account-secrets-store",
      "secret_name": "STRIPE_RESTRICTED_KEY",
    },
    // Grasp's Rooms' read-only service token (grasplabs/rooms,
    // worker/service-read.ts), for the proposal under Contract
    // (src/proposal/rooms.ts): it reads rooms and their signature requests
    // and nothing else. The admin's alone, never sent to the browser.
    // Optional: added to the stage's 1Password Environment, it's bound at
    // the next Deploy platform; until then, the proposal says Rooms isn't
    // connected.
    {
      "binding": "ROOMS_READ_TOKEN",
      "store_id": "account-secrets-store",
      "secret_name": "ROOMS_READ_TOKEN",
    },
    // The Discord webhook the admin's morning digest is posted to, which
    // names the channel (src/admin/discord-digest.ts). The admin's alone.
    // Optional: added to the stage's 1Password Environment, it's bound at
    // the next Deploy platform; until then, no digest is sent.
    {
      "binding": "DISCORD_DIGEST_WEBHOOK",
      "store_id": "account-secrets-store",
      "secret_name": "DISCORD_DIGEST_WEBHOOK",
    },
    // A read-only Attio API key (records, object configuration, notes and
    // meetings read; user management read to name deal owners), for the
    // company, its people, deals and calls under Details and the won deals
    // a new organization starts from (src/crm/attio.ts). The admin's
    // alone: never copied to a client, never sent to the browser.
    // Optional: added to the stage's 1Password Environment, it's bound at
    // the next Deploy platform; until then, Details says Attio isn't
    // connected.
    {
      "binding": "ATTIO_READ_KEY",
      "store_id": "account-secrets-store",
      "secret_name": "ATTIO_READ_KEY",
    },
  ],
  // Staging (`wrangler deploy --env staging`, deploy-platform with stage
  // staging): every name from @grasp-os/shared/names with -staging appended,
  // and its own rate limit namespaces. Every secret it binds has its own
  // name in the account's Secrets Store, `_STAGING` appended
  // (`storeSecretName`), so a staging deploy never writes or reads one
  // production uses.
  "env": {
    "staging": {
      "name": "grasp-admin-staging",
      "routes": [
        {
          "pattern": "admin.staging.ongrasp.app/*",
          "zone_name": "ongrasp.app",
        },
      ],
      "vars": {
        "STAGE": "staging",
        "CF_ACCESS_AUD": "d9c971fada72b860273c91d805c70f07a73ccf1596aa81ff986ff3141d36619d",
        "CF_ACCESS_ISS": "https://grasp-work.cloudflareaccess.com",
        "ENTRA_CLIENT_ID": "01228906-bd5b-488e-b7c1-720f4dc12dc2",
        "GOOGLE_CLIENT_ID": "740037143590-9sb4tsn4di5lqvq5vc1ldtr2kgmm16p2.apps.googleusercontent.com",
        "CLIENT_DOMAIN": "staging.ongrasp.app",
        "ADMIN_HOST": "admin.staging.ongrasp.app",
        "OAUTH_RELAY": "on",
        "ROOMS_ORIGIN": "",
        "DISCORD_PUBLIC_KEY": "",
        "DISCORD_STAFF_IDS": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "grasp-admin-staging",
          "migrations_dir": "src/db/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "RELEASES",
          "bucket_name": "grasp-releases-staging",
          "jurisdiction": "eu",
        },
      ],
      "ratelimits": [
        {
          "name": "ADMIN_MCP_RATE_LIMIT",
          "namespace_id": "2004",
          "simple": {
            "limit": 30,
            "period": 60,
          },
        },
        {
          "name": "DISCORD_RATE_LIMIT",
          "namespace_id": "2005",
          "simple": {
            "limit": 10,
            "period": 60,
          },
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CHAT_STATE",
            "class_name": "ChatState",
          },
          {
            "name": "ADMIN_RUNS",
            "class_name": "AdminRuns",
          },
        ],
      },
      "kv_namespaces": [
        {
          "binding": "ROUTER_HOSTS",
          "id": "router-hosts-namespace",
        },
      ],
      "dispatch_namespaces": [
        {
          "binding": "DISPATCHER",
          "namespace": "grasp-clients-staging",
        },
      ],
      "secrets_store_secrets": [
        {
          "binding": "DEPLOYER_API_TOKEN",
          "store_id": "account-secrets-store",
          "secret_name": "DEPLOYER_API_TOKEN_STAGING",
        },
        {
          "binding": "ROUTER_KEY",
          "store_id": "account-secrets-store",
          "secret_name": "ROUTER_KEY_STAGING",
        },
        {
          "binding": "CLIENT_KEY",
          "store_id": "account-secrets-store",
          "secret_name": "CLIENT_KEY_STAGING",
        },
        {
          "binding": "ENTRA_CLIENT_SECRET",
          "store_id": "account-secrets-store",
          "secret_name": "ENTRA_CLIENT_SECRET_STAGING",
        },
        {
          "binding": "MICROSOFT_CLIENT_SECRET",
          "store_id": "account-secrets-store",
          "secret_name": "MICROSOFT_CLIENT_SECRET_STAGING",
        },
        {
          "binding": "GOOGLE_CLIENT_SECRET",
          "store_id": "account-secrets-store",
          "secret_name": "GOOGLE_CLIENT_SECRET_STAGING",
        },
        {
          "binding": "COMPOSIO_API_KEY",
          "store_id": "account-secrets-store",
          "secret_name": "COMPOSIO_API_KEY_STAGING",
        },
        {
          "binding": "APP_OAUTH_CLIENTS",
          "store_id": "account-secrets-store",
          "secret_name": "APP_OAUTH_CLIENTS_STAGING",
        },
        {
          "binding": "OPENAI_API_KEY",
          "store_id": "account-secrets-store",
          "secret_name": "OPENAI_API_KEY_STAGING",
        },
        {
          "binding": "ANTHROPIC_API_KEY",
          "store_id": "account-secrets-store",
          "secret_name": "ANTHROPIC_API_KEY_STAGING",
        },
        {
          "binding": "MISTRAL_API_KEY",
          "store_id": "account-secrets-store",
          "secret_name": "MISTRAL_API_KEY_STAGING",
        },
        {
          "binding": "OPENROUTER_API_KEY",
          "store_id": "account-secrets-store",
          "secret_name": "OPENROUTER_API_KEY_STAGING",
        },
        {
          "binding": "ELEVENLABS_API_KEY",
          "store_id": "account-secrets-store",
          "secret_name": "ELEVENLABS_API_KEY_STAGING",
        },
        {
          "binding": "STRIPE_RESTRICTED_KEY",
          "store_id": "account-secrets-store",
          "secret_name": "STRIPE_RESTRICTED_KEY_STAGING",
        },
        {
          "binding": "ROOMS_READ_TOKEN",
          "store_id": "account-secrets-store",
          "secret_name": "ROOMS_READ_TOKEN_STAGING",
        },
        {
          "binding": "DISCORD_DIGEST_WEBHOOK",
          "store_id": "account-secrets-store",
          "secret_name": "DISCORD_DIGEST_WEBHOOK_STAGING",
        },
        {
          "binding": "ATTIO_READ_KEY",
          "store_id": "account-secrets-store",
          "secret_name": "ATTIO_READ_KEY_STAGING",
        },
      ],
    },
  },
}
