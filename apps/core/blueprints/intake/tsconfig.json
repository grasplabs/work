{
  // The intake's server code and workflows, checked as core's are, with
  // `#grasp/server` resolved to what the host generates for it
  // (server-types.ts). Its screens import `#grasp`, generated from its
  // manifest, so the screen build checks them (../tsconfig.json leaves
  // them out).
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // A workflow calls the App's functions as `env.APP.callFunction(…)`,
    // written out so the review of its steps reads each call (the SDK's
    // describe.ts). The SDK types `env` as a record of bindings, so with
    // this on, a binding read by name is possibly undefined, and no form
    // the review reads checks. Off here only; GRA-711 types it.
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@xmldom/xmldom": ["../../types/xmldom.d.ts"],
      "#grasp/server": ["./server-types.ts"]
    }
  },
  "include": [
    "server-types.ts",
    "files/*.ts",
    "files/operations",
    "files/workflows"
  ],
  "exclude": []
}
