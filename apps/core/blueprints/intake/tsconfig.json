{
  // The intake's server code, checked as core's are, with
  // `@server/_generated/server` resolved to what the host generates for it
  // (server-types.ts). Its screens import `@server/_generated/api`, generated from its
  // manifest, so the screen build checks them (../tsconfig.json leaves
  // them out).
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@xmldom/xmldom": ["../../types/xmldom.d.ts"],
      "@server/_generated/server": ["./server-types.ts"]
    }
  },
  "include": ["server-types.ts", "files/*.ts", "files/server"],
  "exclude": []
}
