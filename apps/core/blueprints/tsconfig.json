{
  // The built-ins' pages and components run in the browser, on the kit
  // (React and @grasp-os/ui), not in the Worker: checked here, as the
  // compiler checks them when an App builds. Their server code and
  // workflows are core's (../tsconfig.json).
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx"
  },
  "include": ["*/files/src"],
  // Spec 8's layout: its pages import the `@server/_generated/api` the host generates,
  // which nothing here maps; the page build checks them with it.
  "exclude": ["intake/files", "workflow-map/files"]
}
