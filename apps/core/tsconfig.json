{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // drizzle-kit writes each Durable Object's migrations.js.
    "allowJs": true,
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types"
    ],
    // Keeps the browser's globals out of a Worker's types (see the file).
    "paths": { "@xmldom/xmldom": ["./types/xmldom.d.ts"] }
  },
  "include": [
    "src",
    "test",
    "types",
    "blueprints",
    "worker-configuration.d.ts",
    "*.ts"
  ],
  // The built-ins' screens: blueprints/tsconfig.json. The tests' own
  // built-in is an App of spec 8's layout, whose operations import the
  // module its seal generates (`#grasp/server`), which nothing here maps:
  // its files are untyped, like any inline test App's (the seal strips
  // types without checking them), and builtin-blueprints.test.ts covers
  // what they do at runtime. A built-in of spec 8's layout (each of them
  // now) is checked by its own tsconfig.json, which resolves
  // `#grasp/server`.
  "exclude": [
    "blueprints/intake",
    "blueprints/workflow-map",
    "blueprints/board-page",
    "blueprints/*/files/screens",
    "blueprints/*/files/components",
    "test/fixtures/blueprints/*/files"
  ]
}
