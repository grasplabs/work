{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // drizzle-kit writes each Durable Object's migrations.js.
    "allowJs": true,
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types"
    ],
    // Keeps the browser's globals out of a Worker's types (see the file).
    "paths": { "@xmldom/xmldom": ["./types/xmldom.d.ts"] },
    // Core's JSX is Chat SDK's cards (src/channels/cards.tsx), never React:
    // a chat app's card is data each adapter renders natively.
    "jsx": "react-jsx",
    "jsxImportSource": "chat"
  },
  "include": ["src", "test", "types", "worker-configuration.d.ts", "*.ts"],
  // Each built-in (blueprints/) is checked by its own tsconfig.json, as an
  // App. The tests' own built-in imports what its seal generates
  // (`@server/_generated/server`), which nothing here maps: its files are
  // untyped, like any inline test App's (the seal strips types without
  // checking them), and builtin-blueprints.test.ts covers what they do at
  // runtime.
  "exclude": ["test/fixtures/blueprints/*/files"]
}
