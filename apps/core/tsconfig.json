{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // drizzle-kit writes each Durable Object's migrations.js.
    "allowJs": true,
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types"
    ],
    // Keeps the browser's globals out of a Worker's types (see the file).
    "paths": { "@xmldom/xmldom": ["./types/xmldom.d.ts"] }
  },
  "include": [
    "src",
    "test",
    "types",
    "blueprints",
    "worker-configuration.d.ts",
    "*.ts"
  ],
  // The built-ins' screens: blueprints/tsconfig.json. The tests' own
  // built-in is an App of spec 8's layout, whose operations import the
  // module its seal generates (`#grasp/server`): the compiler checks it as
  // it seals, as any App's.
  "exclude": [
    "blueprints/*/files/screens",
    "blueprints/*/files/components",
    "test/fixtures/blueprints/*/files"
  ]
}
