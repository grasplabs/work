{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  // The SDK's loader of oxc-parse.wasm in Node.js too, which the SDK's
  // own tsconfig.json checks without Node's types, and the test config
  // the projects that run its parser share, which Vitest loads in Node.js.
  "include": [
    "*.ts",
    "scripts",
    "packages/runtime/src/common/oxc-parse-module.node.ts",
    "packages/runtime/oxc-parse-test-config.ts"
  ]
}
