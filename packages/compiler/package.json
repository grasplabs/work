{
  "name": "@grasp-os/compiler",
  "private": true,
  "description": "App compiler: builds an App's screens into ES modules and CSS, in its own isolate",
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#kit": {
      "types": "./src/kit-module.d.ts"
    },
    "#types": {
      "types": "./src/types-module.d.ts"
    },
    "#ultracite-rules": {
      "types": "./src/ultracite-rules.d.ts"
    },
    "#version": {
      "types": "./src/version.d.ts",
      "default": "./dist/version.js"
    }
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node build.ts"
  },
  "dependencies": {
    "@babel/standalone": "catalog:",
    "@grasp-os/sdk": "workspace:*",
    "@grasp-os/shared": "workspace:*",
    "@grasp-os/ui": "workspace:*",
    "@shadcn/lint": "catalog:",
    "@tsrs/wasm": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "esbuild-wasm": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-promise": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "lucide-react": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-refresh": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:typescript6"
  },
  "devDependencies": {
    "@babel/parser": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@grasp-os/sdk": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "rolldown": "catalog:",
    "rolldown-plugin-dts": "catalog:",
    "ultracite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  }
}
