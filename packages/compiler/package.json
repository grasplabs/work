{
  "name": "@grasp-os/compiler",
  "private": true,
  "description": "App compiler: builds an App's screens into ES modules and CSS, in its own isolate",
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#kit": {
      "types": "./src/kit-module.d.ts"
    },
    "#types": {
      "types": "./src/types-module.d.ts"
    },
    "#ultracite-config": {
      "types": "./src/ultracite-config.d.ts"
    },
    "#version": {
      "types": "./src/version.d.ts",
      "default": "./dist/version.js"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./css": "./src/packages/css.ts"
  },
  "scripts": {
    "build": "node build.ts"
  },
  "dependencies": {
    "@babel/standalone": "catalog:",
    "@grasp-os/sdk": "workspace:*",
    "@grasp-os/shared": "workspace:*",
    "@grasp-os/ui": "workspace:*",
    "@oxc-parser/binding-wasm32-wasip1": "catalog:",
    "@shadcn/lint": "catalog:",
    "@tsrs/wasm": "catalog:",
    "@tybys/wasm-util": "catalog:",
    "@typescript-eslint/scope-manager": "catalog:",
    "@typescript-eslint/visitor-keys": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "es-module-lexer": "catalog:",
    "esbuild-wasm": "catalog:",
    "eslint": "catalog:",
    "lucide-react": "catalog:",
    "oxc-parser": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-refresh": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@babel/parser": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@grasp-os/sdk": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxfmt": "catalog:oxc",
    "oxlint": "catalog:oxc",
    "rolldown": "catalog:",
    "rolldown-plugin-dts": "catalog:",
    "ultracite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  }
}
