node scripts/check-branch-name.ts
# Format, lint and types of the files this branch changed since main, as
# static checks them all in CI: 4 to 6 s for a pull request of 12 to 23
# files (October 2026), against CI's full `vp check`. A change that breaks
# a file it didn't touch is still static's to find. Without origin/main
# (a clone that never fetched it) only the branch name is checked.
base=$(git merge-base origin/main HEAD 2>/dev/null) || exit 0
files=$(git diff --name-only --diff-filter=ACMR "$base" HEAD)
[ -z "$files" ] && exit 0
git diff -z --name-only --diff-filter=ACMR "$base" HEAD | xargs -0 vp check --no-error-on-unmatched-pattern
